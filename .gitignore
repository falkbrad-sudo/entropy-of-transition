# Data: never commit downloaded datasets, even public ones (repo size + licensing)
data/external/
data/raw/
!data/**/.gitkeep

# Processed outputs stay local too, except the derived tables the Streamlit app
# reads, so the deployed app runs from a clone (see README, Deploying the app)
data/processed/*
!data/processed/metrica_counter_attacks.csv
!data/processed/metrica_sequence_timeseries.csv
!data/processed/metrica_sequence_positions.csv
!data/processed/statsbomb_average_positions.csv
!data/processed/statsbomb_formation_windows.csv
!data/processed/statsbomb_formation_by_match.csv

# Python
__pycache__/
*.pyc
.venv/
venv/
*.egg-info/
.pytest_cache/
.ruff_cache/

# Notebooks
.ipynb_checkpoints/

# OS / editor
.DS_Store
.vscode
.idea

# Local shell / tool config: keep out of a public repo
.bashrc
.bash_profile
.profile
.zshrc
.zprofile
.gitconfig
.ripgreprc
.mcp.json
.gitmodules
.claude/

# Streamlit
.streamlit/secrets.toml

# Local AI-assistant notes, not published (see METHODOLOGY.md)
CLAUDE.md
